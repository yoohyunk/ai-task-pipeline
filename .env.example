# ── Claude (extraction · PRD · agent · conversational edits) ──────────
# Required when MOCK_EXTERNAL=false. Create at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Gemini (embedding dedup) ──────────────────────────────────────────
# Free key at https://aistudio.google.com
GEMINI_API_KEY=

# ── Google Meet (live meeting transcripts) ────────────────────────────
# OAuth for the Meet REST API (scope meetings.space.readonly). When absent,
# meet ingestion falls back to the fixture. (Live path implemented, unverified.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Jira (ticket creation / update / transition) ──────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# ── Slack ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                # xoxb-…  (scopes: chat:write, channels:history,
                                #          channels:read, users:read, reactions:write)
SLACK_APP_TOKEN=                # xapp-…  Socket Mode (scope connections:write)
SLACK_SIGNING_SECRET=           # only if you use HTTP mode instead of Socket Mode
SLACK_APPROVAL_CHANNEL=         # channel ID, e.g. C0XXXXXXXXX
SLACK_INGEST_CHANNEL=           # optional — source channel; defaults to approval channel

# ── Redis (gate state + watermark) ────────────────────────────────────
# Optional — defaults to redis://localhost:6379. Free: https://upstash.com
REDIS_URL=redis://localhost:6379

# ── Pipeline controls ─────────────────────────────────────────────────
# Mock all external services (true) vs go live per available key (false).
MOCK_EXTERNAL=true
# Source: 'fixtures' (synthetic) or 'slack' (live channel).
INGEST_SOURCE=fixtures
# Read only new messages since last run (per-channel watermark). On for `watch`.
INGEST_WATERMARK=false

# Gate behaviour: 'auto' (auto-approve) · 'cli' (terminal) · 'slack' (buttons).
GATE_MODE=auto
GATE_AUTO_APPROVE_MS=8000

# Agent: 'symbolic' (canned diffs) or 'live' (Claude writes code).
AGENT_MODE=symbolic
# How many tickets the agent processes (in parallel).
AGENT_TASK_LIMIT=1
# Open a real GitHub PR via `gh` (needs `gh auth login`), else mock.
CREATE_REAL_PR=false

# ── Scheduled daemon (npm run watch) ──────────────────────────────────
WATCH_INTERVAL_MS=7200000       # 2h
WATCH_START_HOUR=9
WATCH_END_HOUR=18
WATCH_DAYS=1,2,3,4,5            # Mon–Fri
