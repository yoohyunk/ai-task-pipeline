# ── Claude (extraction) ───────────────────────────────────────────────
# Required. Create at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Gemini (embedding dedup) ──────────────────────────────────────────
# Required for Phase 5 dedup. Free key at https://aistudio.google.com
GEMINI_API_KEY=

# ── Jira (ticket creation) ────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TASK

# ── Slack (Gate 1 + Gate 2 messages) ──────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# ── Redis (gate state) ────────────────────────────────────────────────
# Optional — defaults to redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Demo controls ─────────────────────────────────────────────────────
# When true, gates auto-approve after GATE_AUTO_APPROVE_MS so `npm run demo`
# runs end-to-end without a human clicking Slack buttons.
GATE_AUTO_APPROVE=true
GATE_AUTO_APPROVE_MS=8000
# When true, external services with missing keys fall back to mock mode
# (no real Slack/Jira/Gemini calls). Lets the full flow run offline.
MOCK_EXTERNAL=true
